CAPI=2:
# Generated by verification/scripts/generate_core.py; do not edit.
name: aixsilicon:cbb:packet_locking_arbiter:0.1.0
description: Packet-granular round-robin arbitration with EOP or accepted-beat length
  release.
filesets:
  rtl:
    files:
    - ../rtl/packet_locking_arbiter.sv
    file_type: systemVerilogSource
    depend:
    - aixsilicon:cbb:fixed_priority_arbiter:0.1.0
  example:
    files:
    - ../examples/packet_mux.sv
    file_type: systemVerilogSource
  tb:
    files:
    - ../verification/simulation/pla_tb.sv
    file_type: systemVerilogSource
  sdc:
    files:
    - ../constraints/packet_locking_arbiter.sdc
    file_type: SDC
parameters:
  NUM_REQ:
    datatype: int
    paramtype: vlogparam
    default: 4
    description: Number of requesters; arbitrary non-power-of-two counts supported.
  LOCK_MODE:
    datatype: int
    paramtype: vlogparam
    default: 0
    description: 0 releases on accepted EOP; 1 releases after sampled packet length
      accepted beats.
  LEN_W:
    datatype: int
    paramtype: vlogparam
    default: 8
    description: Packet length width; legal runtime length is 1 through 2**LEN_W-1;
      ignored in EOP mode.
targets:
  default:
    filesets:
    - rtl
    toplevel: packet_locking_arbiter
    parameters:
    - NUM_REQ
    - LOCK_MODE
    - LEN_W
  sim:
    default_tool: vcs
    filesets:
    - rtl
    - example
    - tb
    toplevel: pla_tb
    parameters:
    - NUM_REQ
    - LOCK_MODE
    - LEN_W
    tools:
      vcs:
        vcs_options:
        - -full64
        - -timescale=1ns/1ps
  synth:
    filesets:
    - rtl
    - sdc
    toplevel: packet_locking_arbiter
    parameters:
    - NUM_REQ
    - LOCK_MODE
    - LEN_W
  formal:
    filesets:
    - rtl
    toplevel: packet_locking_arbiter
    parameters:
    - NUM_REQ
    - LOCK_MODE
    - LEN_W
