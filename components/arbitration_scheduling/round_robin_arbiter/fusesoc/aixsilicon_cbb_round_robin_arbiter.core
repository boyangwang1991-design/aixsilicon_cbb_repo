CAPI=2:

# FuseSoC Core — round_robin_arbiter (ARB-002)
# VLNV: aixsilicon:cbb:round_robin_arbiter:0.1.0
# 极简单文件：wrapper + 三实现同居 round_robin_arbiter.sv；PC_IMPL 编译期选择
name: aixsilicon:cbb:round_robin_arbiter:0.1.0
description: "Round-robin arbiter CBB, A2, mask/rotate+priority/pointer microarchitectures with optional latched/registered/ack-locked grant"
provider:
  name: aixsilicon
  library: cbb

filesets:
  rtl_src:
    files:
      - ../rtl/round_robin_arbiter.sv   # wrapper（参数检查/SVA/实现分派 + mask/rotate_prio/pointer）
    file_type: systemVerilogSource

  tb_src:
    files:
      - ../verification/simulation/rra_tb.sv
    file_type: systemVerilogSource

  neg_tb_src:
    files:
      - ../verification/formal/negative_elab_tb.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets: [rtl_src]
  sim:
    default_tool: vcs
    filesets: [rtl_src, tb_src]
    toplevel: [rra_tb]
  synth:
    default_tool: dc
    filesets: [rtl_src]
    toplevel: [round_robin_arbiter]
  lint:
    default_tool: spyglass
    filesets: [rtl_src]
    toplevel: [round_robin_arbiter]

parameters:
  NUM_REQ:
    datatype: int
    default: 8
    description: "Number of requesters [2..64] (PC-001/002)"
  REQ_TYPE:
    datatype: int
    default: 0
    description: "Request type {0=level,1=latched until grant_ack}"
  FAST_GRANT:
    datatype: int
    default: 0
    description: "Grant output {0=combinational,1=registered (1 cycle)}"
  PC_IMPL:
    datatype: int
    default: 0
    description: "Microarchitecture select {0=mask chain,1=rotate+priority,2=pointer}"
  GRANT_ACK_EN:
    datatype: int
    default: 0
    description: "Grant lock {0=per-cycle re-arbitrate,1=lock until grant_ack}"
