CAPI=2:
# Build metadata normalized by packet_locking_arbiter/verification/scripts/generate_core.py.
name: aixsilicon:cbb:fixed_priority_arbiter:0.1.0
description: Fixed-priority arbiter CBB, A2, linear/tree/grouped microarchitectures
  with optional latched/registered grant
filesets:
  rtl_src:
    files:
    - ../rtl/fixed_priority_arbiter.sv
    file_type: systemVerilogSource
  tb_src:
    files:
    - ../verification/simulation/fpa_tb.sv
    file_type: systemVerilogSource
targets:
  default:
    filesets:
    - rtl_src
    parameters:
    - NUM_REQ
    - PRIORITY
    - REQ_TYPE
    - FAST_GRANT
    - PC_IMPL
  sim:
    default_tool: vcs
    filesets:
    - rtl_src
    - tb_src
    toplevel:
    - fpa_tb
    tools:
      vcs:
        vcs_options:
        - -full64
        - -timescale=1ns/1ps
  synth:
    default_tool: dc
    filesets:
    - rtl_src
    toplevel:
    - fixed_priority_arbiter
    parameters:
    - NUM_REQ
    - PRIORITY
    - REQ_TYPE
    - FAST_GRANT
    - PC_IMPL
  lint:
    default_tool: spyglass
    filesets:
    - rtl_src
    toplevel:
    - fixed_priority_arbiter
    parameters:
    - NUM_REQ
    - PRIORITY
    - REQ_TYPE
    - FAST_GRANT
    - PC_IMPL
parameters:
  NUM_REQ:
    datatype: int
    default: 8
    description: Number of requesters [2..64] (PC-001/002)
    paramtype: vlogparam
  PRIORITY:
    datatype: int
    default: 0
    description: Priority direction {0=LSB first,1=MSB first}（int 枚举，DC 综合不支持 string）
    paramtype: vlogparam
  REQ_TYPE:
    datatype: int
    default: 0
    description: Request type {0=level,1=latched until grant_ack}
    paramtype: vlogparam
  FAST_GRANT:
    datatype: int
    default: 0
    description: Grant output {0=combinational,1=registered (1 cycle)}
    paramtype: vlogparam
  PC_IMPL:
    datatype: int
    default: 0
    description: Microarchitecture select {0=linear chain,1=tree prefix,2=grouped}
    paramtype: vlogparam
