CAPI=2:

name: aixsilicon:cbb:memory_sleep_ctrl:0.1.0
description: |
  MEM-015 Memory Sleep/Retention Controller - break-even时间、唤醒

filesets:
  rtl_interface:
    files:
      - ../rtl/interface/*.sv
    file_type: systemVerilogSource
  rtl_impl:
    files:
      - ../rtl/impl/*.sv
    file_type: systemVerilogSource
  sim_tb:
