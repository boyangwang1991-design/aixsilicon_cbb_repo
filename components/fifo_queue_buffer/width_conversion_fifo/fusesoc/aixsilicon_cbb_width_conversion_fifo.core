CAPI=2:

# ============================================================
# FuseSoC Core —— QUE-012 width_conversion_fifo
# VLNV: aixsilicon:cbb:width_conversion_fifo:0.1.0
# ============================================================
name: aixsilicon:cbb:width_conversion_fifo:0.1.0
description: |
  width_conversion_fifo - 单时钟同步 FIFO + 整数比宽度转换（A2/A3）。
  DIRECTION 参数切换 窄->宽 / 宽->窄；共享契约见 cbb.yaml / behavior.yaml。

filesets:
  # 轻量合并布局：pkg + module 同居 rtl/width_conversion_fifo.sv（artifact-contract §2）
  rtl_src:
    files:
      - ../rtl/width_conversion_fifo.sv
    file_type: systemVerilogSource

  # 注：verif_common/assertions/formal 文件集仅在对应目录存在独立文件时由 target 引用；
  #     本构件 SVA 内嵌于 RTL（rtl/width_conversion_fifo.sv），故 target 不引用它们。
  verif_common:
    files:
      - ../verification/common/*.sv
    file_type: systemVerilogSource

  sim_tb:
    files:
      - ../verification/simulation/*.sv
    file_type: systemVerilogSource

  assertions:
    files:
      - ../verification/assertions/*.sv
    file_type: systemVerilogSource

  formal:
    files:
      - ../verification/formal/*.sv
      - ../verification/formal/*.sva
    file_type: systemVerilogSource

targets:
  rtl:
    filesets:
      - rtl_src

  synth:
    filesets:
      - rtl_src
    tools:
      dc:
        synth_file: ../constraints/width_conversion_fifo.sdc
    default_tool: dc

  sim:
    filesets:
      - rtl_src
      - sim_tb
    toplevel: width_conversion_fifo_tb

  formal:
    filesets:
      - rtl_src

  default:
    filesets:
      - rtl_src
