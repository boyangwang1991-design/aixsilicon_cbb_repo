CAPI=2:

# FuseSoC Core — skid_buffer (QUE-007, v0.2.0 多实现)
# VLNV: aixsilicon:cbb:skid_buffer:0.2.0
# 多实现：wrapper（BYPASS/IMPL 分派）+ rtl/impl/{forward,full}（极简单文件，无 package/interface）
name: aixsilicon:cbb:skid_buffer:0.2.0
description: "Valid-Ready pipeline stage CBB, A3: forward/full microarchitectures + BYPASS direct, multi-impl profile"
provider:
  name: aixsilicon
  library: cbb

filesets:
  rtl_src:
    files:
      - ../rtl/skid_buffer.sv                       # wrapper（参数检查/BYPASS/IMPL 分派）
      - ../rtl/impl/forward/skid_buffer.sv          # impl_forward（简单打拍）
      - ../rtl/impl/full/skid_buffer.sv             # impl_full（OUT+SKID 槽）
      - ../rtl/impl/backward/skid_buffer.sv         # impl_backward（ready 寄存/透传）
    file_type: systemVerilogSource

  tb_src:
    files:
      - ../verification/simulation/skid_buffer_tb.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets: [rtl_src]
  sim:
    default_tool: vcs
    filesets: [rtl_src, tb_src]
    toplevel: [skid_buffer_tb]
  synth:
    default_tool: dc
    filesets: [rtl_src]
    toplevel: [skid_buffer]
  lint:
    default_tool: spyglass
    filesets: [rtl_src]
    toplevel: [skid_buffer]

parameters:
  DATA_W:
    datatype: int
    default: 32
    description: "Data width [1..1024] (PC-001/002)"
  IMPL:
    datatype: int
    default: 1
    description: "Microarchitecture {0=forward,1=full} (PC-003)"
  BYPASS:
    datatype: int
    default: 0
    description: "Direct combinational bypass {0,1} (PC-004)"
