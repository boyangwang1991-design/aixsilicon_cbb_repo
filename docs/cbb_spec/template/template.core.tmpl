CAPI=2:

# ============================================================
# FuseSoC Core 模板（CAPI=2）
# ------------------------------------------------------------
# 供开发 CBB 时复制到其 fusesoc/ 目录，文件名为
# <vendor>_<library>_<cbb_name>.core。
#
# 占位符:
#   __VENDOR__    - 供应商（默认 aixsilicon）
#   __LIBRARY__   - 库名（默认 cbb）
#   __CBB_NAME__  - 构件名（如 async_fifo）
#   __CBB_VERSION__ - SemVer 版本（默认 0.1.0）
#
# 路径规则: 文件集路径相对本 .core 文件所在目录（fusesoc/），
# 因此使用 ../ 引用包内 rtl/、verification/、constraints/ 等。
# 目录布局遵循架构文档 9.3 节标准工程包。
# ============================================================

# VLNV: <vendor>:<library>:<name>:<version>
name: __VENDOR__:__LIBRARY__:__CBB_NAME__:__CBB_VERSION__
description: |
  __CBB_NAME__ - 可配置构建块（CBB）。默认 target 引用 rtl/impl 下的默认实现；
  更多实现（微架构变体）按需添加 target 并切换 impl 文件集。

# ================= 文件集 =================
filesets:
  # 接口定义（契约文件，所有实现共享）
  rtl_interface:
    files:
      - ../rtl/interface/*.sv
      - ../rtl/interface/*.svh:
          is_include_file: true
          file_type: systemVerilogHeader
    file_type: systemVerilogSource

  # 默认实现（微架构）
  rtl_impl:
    files:
      - ../rtl/impl/*.sv
    file_type: systemVerilogSource

  # 公共验证框架（VIP / Harness）
  verif_common:
    files:
      - ../verification/common/*.sv
    file_type: systemVerilogSource

  # 仿真测试平台
  sim_tb:
    files:
      - ../verification/simulation/*.sv
    file_type: systemVerilogSource

  # 断言（SVA / formal properties）
  assertions:
    files:
      - ../verification/assertions/*.sv
    file_type: systemVerilogSource

# ================= 目标 =================
targets:
  rtl:
    filesets:
      - rtl_interface
      - rtl_impl

  synth:
    filesets:
      - rtl_interface
      - rtl_impl
    tools:
      dc:
        synth_file: ../constraints/__CBB_NAME__.sdc
    default_tool: dc

  sim:
    filesets:
      - rtl_interface
      - rtl_impl
      - verif_common
      - sim_tb
      - assertions
    toplevel: __CBB_NAME___tb

  formal:
    filesets:
      - rtl_interface
      - rtl_impl
      - assertions

  default:
    filesets:
      - rtl_interface
      - rtl_impl
